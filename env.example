# Port the server listens on
PORT=3002

# Comma-separated list of origins allowed to call this API — set to your real site URL(s)
ALLOWED_ORIGINS=http://localhost:3000,https://your-website.com

# A long random secret only YOU know. The admin dashboard (public/admin.html)
# asks for this before showing any orders. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=change_this_to_a_long_random_secret

# ---- Order confirmation emails (optional but recommended) ----
# Any SMTP account works (Gmail app password, Zoho Mail, your hosting provider's SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
NOTIFY_EMAIL=owner@yourshop.com
STORE_NAME=StyleAI Studio

# ---- Payment gateway (optional — leave blank to stay Cash-on-Delivery only) ----
# Recommended for Pakistan: an aggregator like Safepay or PayFast that gives you
# JazzCash + Easypaisa + Cards through ONE integration instead of three separate
# merchant applications. See README.md "Payment gateway" section before filling these in.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_SECRET=
